{
  "name": "@cred/core",
  "version": "0.1.0",
  "description": "Framework-agnostic, storage-agnostic authentication core: registration, login, token rotation, OAuth linking, profiles, and audit logging.",
  "keywords": [
    "cred",
    "auth",
    "authentication",
    "jwt",
    "refresh-tokens",
    "oauth",
    "audit"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NehanAhmed/cred.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/NehanAhmed/cred/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/NehanAhmed/cred/issues"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
