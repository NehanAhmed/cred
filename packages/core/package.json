{
  "name": "@cred-kit/core",
  "version": "0.1.1",
  "description": "Framework-agnostic, storage-agnostic authentication core for Node.js: registration, verified email login, rotating refresh tokens with reuse detection, OAuth account linking, profiles, and audit logging.",
  "keywords": [
    "cred-kit",
    "auth",
    "authentication",
    "jwt",
    "jsonwebtoken",
    "refresh-token",
    "refresh-token-rotation",
    "token-rotation",
    "oauth",
    "oauth2",
    "password-hashing",
    "bcrypt",
    "email-verification",
    "password-reset",
    "account-lockout",
    "profile-management",
    "audit-log",
    "zod",
    "typescript",
    "esm",
    "nodejs",
    "framework-agnostic",
    "storage-agnostic",
    "adapter"
  ],
  "license": "MIT",
  "author": "NehanAhmed (https://github.com/NehanAhmed)",
 "repository": {
    "type": "git",
    "url": "git+https://github.com/NehanAhmed/cred-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/NehanAhmed/cred-kit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/NehanAhmed/cred-kit/issues"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "unrun": "^0.3.1",
    "vitest": "^5.1.1"
  }
}
