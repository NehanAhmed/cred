{
  "name": "@cred/mongo-storage",
  "version": "0.1.0",
  "description": "MongoDB/Mongoose storage adapter for Cred authentication data.",
  "keywords": [
    "cred",
    "auth",
    "authentication",
    "mongodb",
    "mongoose",
    "storage",
    "adapter"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NehanAhmed/cred.git",
    "directory": "packages/mongo-storage"
  },
  "homepage": "https://github.com/NehanAhmed/cred/tree/main/packages/mongo-storage#readme",
  "bugs": {
    "url": "https://github.com/NehanAhmed/cred/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cred/core": "workspace:*",
    "mongoose": "^9.7.0"
  },
  "devDependencies": {
    "@cred/config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "mongodb-memory-server": "^11.2.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
