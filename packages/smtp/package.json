{
  "name": "@cred-kit/smtp",
  "version": "0.2.0",
  "description": "SMTP (Nodemailer) and Resend email adapter for cred-kit authentication flows.",
  "keywords": [
    "cred-kit",
    "auth",
    "authentication",
    "smtp",
    "nodemailer",
    "resend",
    "email",
    "email-adapter",
    "transactional-email",
    "email-verification",
    "password-reset",
    "esm",
    "typescript",
    "adapter"
  ],
  "author": "Nehan Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NehanAhmed/cred-kit.git",
    "directory": "packages/smtp"
  },
  "homepage": "https://github.com/NehanAhmed/cred-kit/tree/main/packages/smtp#readme",
  "bugs": {
    "url": "https://github.com/NehanAhmed/cred-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
"dist","README.md"  ],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@cred-kit/core": "workspace:*",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@cred-kit/core": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "nodemailer": "^10.6.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
