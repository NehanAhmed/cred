# Normalize line endings: files are stored with LF in git and checked out as LF
# on every OS. Windows checkouts would otherwise get CRLF, which breaks
# Prettier and ESLint line-ending rules and produces noisy diffs.
* text=auto eol=lf

# Windows scripts must keep CRLF if they are ever added
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.pdf binary
*.tgz binary