{
  "name": "cred",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\""
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4.2.0": ">=4.2.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "turbo": "^2.5.2",
    "typescript": "^6.0.3"
  }
}
