# Copy this file to .env.local and replace every placeholder.
# .env.local is ignored by git and must never be committed.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cred-demo
JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-username
SMTP_PASS=replace-with-your-smtp-password
